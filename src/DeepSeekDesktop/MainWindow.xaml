<Window x:Class="DeepSeekDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DeepSeekDesktop"
 Title="DeepSeek Desktop" Icon="Assets/deepseek-whale-girl.ico" Width="1080" Height="780" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#F4F6FB" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Closing="Window_Closing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#14213D">
   <DockPanel Margin="18,28,18,20">
    <StackPanel DockPanel.Dock="Top">
     <Image Source="Assets/deepseek-whale-girl.png" Width="48" Height="48" HorizontalAlignment="Left" Stretch="Uniform"/>
     <TextBlock Text="DeepSeek" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,14,0,0"/>
     <TextBlock Text="DESKTOP · 本地连接" Foreground="#8C9CBD" FontSize="10" Margin="0,5,0,30"/>
     <Button Content="◉    服务概览" Tag="0" Click="Navigate_Click" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
     <Button Content="☷    账号管理" Tag="1" Click="Navigate_Click" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
     <Button Content="⚙    连接设置" Tag="2" Click="Navigate_Click" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
     <Button Content="≡    运行日志" Tag="3" Click="Navigate_Click" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <TextBlock Text="仅在本机提供 API" Foreground="#A1B1CE" Margin="0,0,0,8"/>
     <TextBlock x:Name="VersionLabel" Text="{Binding Source={x:Static local:App.Version}, StringFormat={}{0} · 非官方客户端}" Foreground="#7E90B1" FontSize="11" Margin="0,0,0,18"/>
     <Button x:Name="SidebarUpdateButton" Content="发现新版，查看更新" Click="ShowUpdates_Click" Visibility="Collapsed" FontSize="11" Padding="6,8" Margin="0,0,0,10"/>
     <Button Content="退出程序" Click="Exit_Click" Background="#223353" Foreground="#CBD5EC" Margin="0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,26,30,16">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TabControl x:Name="Pages" Background="Transparent" BorderThickness="0" SelectedIndex="0">
    <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
    <TabItem Header="服务概览">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
       <TextBlock Text="服务概览" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <TextBlock Text="把 DeepSeek 或智谱清言接到你熟悉的客户端。" Foreground="#7B879E" Margin="0,0,0,16"/>
       <TextBlock Text="当前服务平台（停止服务后可切换）" Style="{StaticResource Label}"/>
       <ComboBox x:Name="ProviderBox" SelectedIndex="0" SelectionChanged="Provider_SelectionChanged" Margin="0,0,0,18" Padding="10,8"><ComboBoxItem Content="DeepSeek"/><ComboBoxItem Content="智谱清言"/></ComboBox>
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <DockPanel><Border x:Name="StatusPill" Background="#EDF0F6" CornerRadius="8" Padding="12,5" DockPanel.Dock="Right"><TextBlock x:Name="ServiceStatus" Text="已停止"/></Border><TextBlock Text="本地 API 服务" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
         <TextBlock x:Name="ServiceDetail" Text="添加账号后，启动本地服务。" Foreground="#7B879E" Margin="0,12,0,18" TextWrapping="Wrap"/>
         <StackPanel Orientation="Horizontal"><Button x:Name="StartButton" Content="启动服务" Background="#4D6BFE" Foreground="White" Click="Start_Click"/><Button x:Name="StopButton" Content="停止服务" Click="Stop_Click" IsEnabled="False"/><Button x:Name="ProbeButton" Content="检查本地接口" Click="Probe_Click" IsEnabled="False"/></StackPanel>
         <TextBlock x:Name="StartupHint" Text="DeepSeek 启动会登录启用账号，并发送后端自带的健康检查消息。" Foreground="#7B879E" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="客户端接入" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock Text="服务商选择 OpenAI 兼容，填写以下连接信息。" Foreground="#7B879E" Margin="0,8,0,12"/>
         <TextBlock Text="API 地址 / Base URL" Style="{StaticResource Label}"/>
         <DockPanel><Button Content="复制地址" DockPanel.Dock="Right" Click="CopyUrl_Click" Margin="8,0,0,0"/><TextBox x:Name="EndpointBox" IsReadOnly="True" FontFamily="Consolas"/></DockPanel>
         <TextBlock Text="API Key" Style="{StaticResource Label}"/>
         <DockPanel><Button Content="复制 Key" DockPanel.Dock="Right" Click="CopyKey_Click" Margin="8,0,0,0"/><TextBox x:Name="ApiKeyBox" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"/></DockPanel>
         <TextBlock x:Name="ModelHint" Text="模型：deepseek-default（网页端当前默认模式）" Margin="0,16,0,4"/>
         <TextBlock Text="适用于 Cherry Studio、AstrBot、Eve pet、tibo watch 的 OpenAI 兼容接入；实际兼容性需在本机验证。" Foreground="#7B879E" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
       <UniformGrid Columns="3" Margin="0,0,0,16">
        <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,8,0"><StackPanel><TextBlock Text="本次请求" Foreground="#7B879E"/><TextBlock x:Name="TotalCount" Text="0" FontSize="26" Margin="0,6,0,0"/></StackPanel></Border>
        <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,8,0"><StackPanel><TextBlock Text="成功" Foreground="#7B879E"/><TextBlock x:Name="SuccessCount" Text="0" FontSize="26" Margin="0,6,0,0"/></StackPanel></Border>
        <Border Background="White" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="失败" Foreground="#7B879E"/><TextBlock x:Name="FailedCount" Text="0" FontSize="26" Margin="0,6,0,0"/></StackPanel></Border>
       </UniformGrid>
       <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button x:Name="TestButton" Content="发送测试消息" Click="Test_Click" DockPanel.Dock="Right" IsEnabled="False"/><TextBlock Text="真实对话测试" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="向当前平台发送“请仅回复：连接成功”，检查上游回复。" Foreground="#7B879E" Margin="0,12,0,10" TextWrapping="Wrap"/><TextBox x:Name="TestReply" Text="尚未测试" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="账号管理">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
      <TextBlock Text="账号管理" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock Text="停止服务后添加或修改账号。账号凭据通过 Windows 加密保存。" Foreground="#7B879E" Margin="0,0,0,24" TextWrapping="Wrap"/>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="AccountSummary" Text="0 个账号" FontSize="18" FontWeight="SemiBold"/><ListBox x:Name="AccountList" SelectionChanged="AccountList_SelectionChanged" MinHeight="80" MaxHeight="140" BorderThickness="0" Margin="0,14,0,12"/><StackPanel Orientation="Horizontal"><Button x:Name="NewAccountButton" Content="添加账号" Click="NewAccount_Click"/><Button x:Name="DeleteAccountButton" Content="删除选中账号" Click="DeleteAccount_Click"/></StackPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel x:Name="AccountEditor">
       <TextBlock x:Name="AccountEditorTitle" Text="添加账号" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock Text="账号名称" Style="{StaticResource Label}"/><TextBox x:Name="AccountName" MaxLength="60"/>
       <StackPanel x:Name="DeepSeekCredentials">
       <TextBlock Text="邮箱 / 中国大陆手机号（不含 +86）" Style="{StaticResource Label}"/><TextBox x:Name="AccountLogin" MaxLength="254"/>
       <TextBlock Text="登录密码（修改时留空保留原值）" Style="{StaticResource Label}"/><PasswordBox x:Name="AccountPassword" MaxLength="1024"/>
       <TextBlock Text="真实设备 device_id（修改时留空保留原值）" Style="{StaticResource Label}"/><PasswordBox x:Name="AccountDevice" MaxLength="8192"/>
       </StackPanel>
       <StackPanel x:Name="QingyanCredentials" Visibility="Collapsed">
        <TextBlock Text="清言 refresh token（修改时留空保留原值）" Style="{StaticResource Label}"/><PasswordBox x:Name="AccountToken" MaxLength="16384"/>
        <TextBlock Text="从已登录的 chatglm.cn 浏览器中获取 chatglm_refresh_token；不填写清言账号密码。" Foreground="#7B879E" TextWrapping="Wrap" Margin="0,8,0,0"/>
       </StackPanel>
       <CheckBox x:Name="AccountEnabled" Content="启用这个账号" IsChecked="True" Margin="0,18,0,18"/>
       <StackPanel Orientation="Horizontal"><Button Content="保存账号" Click="SaveAccount_Click" Background="#4D6BFE" Foreground="White"/><Button x:Name="CredentialHelpButton" Content="如何获取 device_id" Click="DeviceHelp_Click"/></StackPanel>
      </StackPanel></Border>
      <TextBlock Text="这里只显示当前平台的账号，切换平台会保留另一平台的配置。网页接口可能变化，账号可能受到上游限制；不自动处理浏览器登录或验证码。" Foreground="#7B879E" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="连接设置">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
      <TextBlock Text="连接设置" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock Text="保存后生效；服务运行期间请先停止再修改。" Foreground="#7B879E" Margin="0,0,0,24"/>
      <Border Style="{StaticResource Card}"><StackPanel x:Name="SettingsEditor">
       <TextBlock Text="本地服务" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock Text="监听端口（仅限 127.0.0.1）" Style="{StaticResource Label}"/><TextBox x:Name="PortBox" MaxLength="5"/>
       <TextBlock Text="每账号每小时请求上限" Style="{StaticResource Label}"/><TextBox x:Name="QuotaBox" MaxLength="4"/>
       <TextBlock Text="该限制不会保证账号免受上游限制。" FontSize="11" Foreground="#7B879E" Margin="0,6,0,0"/>
       <TextBlock Text="上游代理地址（可选；留空直连）" Style="{StaticResource Label}"/><TextBox x:Name="ProxyBox" MaxLength="2048"/>
       <CheckBox x:Name="SearchEnabled" Content="未指定搜索选项时默认开启联网搜索" Margin="0,18,0,18"/>
       <StackPanel Orientation="Horizontal"><Button Content="保存设置" Click="SaveSettings_Click" Background="#4D6BFE" Foreground="White"/><Button Content="重新生成 API Key" Click="RegenerateKey_Click"/></StackPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="数据与版本" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="VersionDetail" Text="{Binding Source={x:Static local:App.Version}, StringFormat=桌面端 {0} · 协议引擎 ds-free-api v0.5.1}" Margin="0,14,0,8"/>
       <TextBlock x:Name="UpdateStatus" Text="启动时检查新版，也可手动检查。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,10"/>
       <StackPanel Orientation="Horizontal"><Button x:Name="CheckUpdatesButton" Content="检查更新" Click="CheckUpdates_Click"/><Button x:Name="DownloadUpdateButton" Content="前往下载页" Click="DownloadUpdate_Click"/></StackPanel>
       <TextBlock Text="自动检查使用本机 GitHub CLI 登录状态访问私有仓库；下载页需登录有权限的 GitHub 账号。" Foreground="#7B879E" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,14"/>
       <TextBlock Text="升级时退出旧程序，解压完整新版后运行。同一 Windows 用户下保留账号、API Key 和连接设置。" Foreground="#7B879E" TextWrapping="Wrap" Margin="0,0,0,14"/>
       <TextBlock Text="账号和 API Key 使用当前 Windows 用户的 DPAPI 加密保存。服务运行时，引擎需要临时明文配置；目录限制为当前用户访问，停止后删除。" Foreground="#7B879E" TextWrapping="Wrap"/><TextBlock Text="关闭窗口会静默收起到托盘；点击“退出程序”会停止本地服务。" Margin="0,14,0,14" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button Content="打开数据目录" Click="OpenData_Click"/><Button Content="使用说明" Click="OpenReadme_Click"/></StackPanel></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="运行日志">
     <Grid Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,20"><TextBlock Text="运行日志" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="显示当前会话的后端输出，已隐藏已知凭据。" Foreground="#7B879E" Margin="0,0,0,16"/><StackPanel Orientation="Horizontal"><Button Content="清空显示" Click="ClearLogs_Click"/><Button Content="复制日志" Click="CopyLogs_Click"/></StackPanel></StackPanel>
      <TextBox x:Name="LogsBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Background="#17233D" Foreground="#C9D6EE" BorderThickness="0" Padding="18"/>
     </Grid>
    </TabItem>
   </TabControl>
   <TextBlock x:Name="Notice" Grid.Row="1" Text="就绪 · 服务仅在本机提供访问" Foreground="#64748B" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
